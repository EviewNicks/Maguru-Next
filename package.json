{
  "name": "maguru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:prepare": "node ./scripts/prepare-prod-deps.js",
    "app": "next dev --turbopack",
    "build": "yarn lint && next build",
    "build:prod": "cross-env DOCKER_BUILDKIT=1 COMPOSE_DOCKER_CLI_BUILD=1 DOCKER_DEFAULT_PLATFORM=linux/amd64 docker-compose -f docker-compose.build.yml up --build",
    "build:debug": "cross-env DOCKER_BUILDKIT=1 COMPOSE_DOCKER_CLI_BUILD=1 BUILDKIT_PROGRESS=plain docker-compose -f docker-compose.build.yml up --build",
    "build:prune": "docker builder prune --all",
    "build:bake": "docker buildx bake -f docker-bake.hcl",
    "build:bake:app": "docker buildx bake -f docker-bake.hcl app",
    "build:bake:builder": "docker buildx bake -f docker-bake.hcl builder",
    "clean:docker": "docker rm -f $(docker ps -aq) || true && docker image prune -af || true",
    "clean:deps": "rm -rf node_modules && rm -rf .next && yarn cache clean",
    "clean:all": "yarn clean:docker && yarn clean:deps",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "seed": "tsx prisma/seed.ts",
    "test": "cross-env USE_BABEL=true jest",
    "test:watch": "cross-env USE_BABEL=true jest --watch",
    "test:custom": "jest features/manage-module/__tests__/integration/URLRouting.integration.test.tsx --verbose",
    "test:unit": "jest features/manage-module/components/ModulePageEdit.test.tsx features/manage-module/components/ModulePageView.test.tsx features/manage-module/components/RichTextViewer.test.tsx features/manage-module/components/RichTextEditor.test.tsx --verbose",
    "test:integration": " jest features/manage-module/__tests__/integration/URLRouting.integration.test.tsx features/manage-module/__tests__/integration/ViewEditFlow.integration.test.tsx --verbose",
    "test:performance": "jest features/manage-module/__tests__/performance/ViewerVsEditor.perm.test.tsx --verbose",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright test --reporter=./services/playwrightReporter.js",
    "test:e2e:ui": "playwright test --ui",
    "test:load": "ts-node --project tsconfig.json __tests__/manage-user/load/run-load-test.ts",
    "deps:prod": "yarn install --production=true --frozen-lockfile",
    "deps:dev": "yarn install --production=false --frozen-lockfile"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
