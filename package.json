{
  "name": "maguru",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "app": "next dev --turbopack",
    "app:docker": "docker-compose up -d app",
    "build": "next build",
    "build:docker": "docker-compose up -d build",
    "build:app": "cross-env DOCKER_BUILDKIT=1 COMPOSE_DOCKER_CLI_BUILD=1 docker-compose build app",
    "build:build": "cross-env DOCKER_BUILDKIT=1 COMPOSE_DOCKER_CLI_BUILD=1 docker-compose -f docker-compose.build.yml up --build",
    "build:bake": "docker buildx bake -f docker-bake.hcl",
    "build:bake:app": "docker buildx bake -f docker-bake.hcl app",
    "build:bake:builder": "docker buildx bake -f docker-bake.hcl builder",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "seed": "tsx prisma/seed.ts",
    "test": "cross-env USE_BABEL=true jest",
    "test:watch": "cross-env USE_BABEL=true jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright test --reporter=./services/playwrightReporter.js",
    "test:e2e:ui": "playwright test --ui"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
