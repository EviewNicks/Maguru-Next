          "name": "Update Module Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACTIVE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/module/{{moduleId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["api", "module", "{{moduleId}}", "status"]
            },
            "description": "Memperbarui status modul (DRAFT, ACTIVE, ARCHIVED)."
          },
          "response": []
