    "name": "Maguru Module Management API",
    "description": "API Collection untuk Module Management di Maguru. Collection ini berisi semua endpoint yang terkait dengan pengelolaan modul dan halaman modul.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Module",
      "description": "Endpoint untuk pengelolaan modul",
      "item": [
        {
          "name": "Get All Modules",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/module?page=1&limit=10&status=ACTIVE&search=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "module"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "status",
                  "value": "ACTIVE"
                },
                {
                  "key": "search",
                  "value": ""
                }
              ]
            },
            "description": "Mendapatkan daftar modul dengan paginasi, filter status, dan pencarian."
          },
          "response": []
        },
        {
          "name": "Create Module",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Modul Testing API\",\n  \"description\": \"Ini adalah modul untuk testing API menggunakan Postman\",\n  \"status\": \"DRAFT\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/module",
              "host": ["{{baseUrl}}"],
              "path": ["api", "module"]
            },
            "description": "Membuat modul baru dalam sistem."
          },
          "response": []
        },
        {
          "name": "Get Module by ID",
          "request": {
            "method": "GET",
            "header": [],
