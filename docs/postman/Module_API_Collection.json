    {
      "name": "Module Pages",
      "description": "Endpoint untuk pengelolaan halaman modul",
      "item": [
        {
          "name": "Get Module Pages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/module/{{moduleId}}/pages?page=1&limit=10&includeContent=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "module", "{{moduleId}}", "pages"],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "includeContent",
                  "value": "true"
                }
              ]
            },
            "description": "Mendapatkan daftar halaman untuk modul tertentu dengan format JSONB content."
          },
          "response": []
        },
        {
          "name": "Create Module Page",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Halaman Test Format JSONB\",\n  \"type\": \"content\",\n  \"order\": 1,\n  \"content\": {\n    \"type\": \"doc\",\n    \"content\": [\n      {\n        \"type\": \"heading\",\n        \"attrs\": { \"level\": 1 },\n        \"content\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"Halaman Format JSONB\"\n          }\n        ]\n      },\n      {\n        \"type\": \"paragraph\",\n        \"content\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"Ini adalah contoh konten dengan format JSONB langsung menggunakan struktur Tiptap.\"\n          }\n        ]\n      },\n      {\n        \"type\": \"code_block\",\n        \"attrs\": { \"language\": \"javascript\" },\n        \"content\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"console.log('Direct JSONB Format');\"\n          }\n        ]\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/module/{{moduleId}}/pages",
              "host": ["{{baseUrl}}"],
              "path": ["api", "module", "{{moduleId}}", "pages"]
            },
            "description": "Membuat halaman baru menggunakan format JSONB (format Tiptap). Sekarang HANYA format ini yang didukung oleh API."
          },
          "response": []
        },
        {
          "name": "Reorder Module Pages",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pageIds\": [\"{{pageId1}}\", \"{{pageId2}}\", \"{{pageId3}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/module/{{moduleId}}/pages/reorder",
              "host": ["{{baseUrl}}"],
              "path": ["api", "module", "{{moduleId}}", "pages", "reorder"]
            },
            "description": "Mengubah urutan halaman dalam modul berdasarkan array ID halaman."
          },
          "response": []
        },
        {
          "name": "Get Module Page by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/module/{{moduleId}}/pages/{{pageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "module", "{{moduleId}}", "pages", "{{pageId}}"]
            },
            "description": "Mendapatkan detail halaman modul berdasarkan ID halaman dalam format JSONB."
          },
          "response": []
        },
        {
          "name": "Update Module Page",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Halaman Test JSONB (Updated)\",\n  \"type\": \"content\",\n  \"content\": {\n    \"type\": \"doc\",\n    \"content\": [\n      {\n        \"type\": \"heading\",\n        \"attrs\": { \"level\": 2 },\n        \"content\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"Heading yang Diperbarui\"\n          }\n        ]\n      },\n      {\n        \"type\": \"paragraph\",\n        \"content\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"Ini adalah contoh konten yang diperbarui menggunakan format JSONB langsung.\"\n          }\n        ]\n      },\n      {\n        \"type\": \"paragraph\",\n        \"content\": [\n          {\n            \"type\": \"text\",\n            \"text\": \"Format ini lebih efisien untuk PostgreSQL dan mengurangi overhead parsing.\"\n          }\n        ]\n      }\n    ]\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/module/{{moduleId}}/pages/{{pageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "module", "{{moduleId}}", "pages", "{{pageId}}"]
            },
            "description": "Memperbarui halaman modul menggunakan format JSONB (format Tiptap). Sekarang HANYA format ini yang didukung oleh API."
          },
          "response": []
        },
        {
          "name": "Update Module Page Status",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"PUBLISHED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/module/{{moduleId}}/pages/{{pageId}}/status",
              "host": ["{{baseUrl}}"],
              "path": [
                "api",
                "module",
                "{{moduleId}}",
                "pages",
                "{{pageId}}",
                "status"
              ]
            },
            "description": "Mengubah status halaman modul (DRAFT, PUBLISHED, ARCHIVED). Status sekarang disimpan langsung di database."
          },
          "response": []
        },
        {
          "name": "Delete Module Page",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/module/{{moduleId}}/pages/{{pageId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "module", "{{moduleId}}", "pages", "{{pageId}}"]
            },
            "description": "Menghapus halaman modul berdasarkan ID halaman."
          },
          "response": []
        }
      ]
    }
