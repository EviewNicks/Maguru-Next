            "description": "Mendapatkan detail modul berdasarkan ID."
          },
          "response": []
        },
        {
          "name": "Update Module",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Modul Testing API Updated\",\n  \"description\": \"Ini adalah modul untuk testing API menggunakan Postman (Updated)\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/module/{{moduleId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "module", "{{moduleId}}"]
