# syntax=docker/dockerfile:1
# Dockerfile untuk proses build dengan penanganan khusus untuk Prisma
FROM node:18-alpine AS builder

WORKDIR /app

# Memperbarui repositori dan menginstal paket yang diperlukan
RUN apk update && apk add --no-cache libc6-compat openssl

# Copy prisma files terlebih dahulu
COPY prisma ./prisma/

# Copy package files dan install dependencies 
COPY package*.json ./
RUN npm ci

# Generate Prisma client
RUN npx prisma generate

# Copy seluruh aplikasi kecuali yang ada di .dockerignore
COPY . .

# Set variabel lingkungan
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max_old_space_size=4096"

# Build aplikasi
RUN npm run build

# Aplikasi tetap di /app karena volume sudah di-mount langsung ke sana
CMD ["echo", "Build completed successfully!"] 