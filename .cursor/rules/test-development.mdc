# 5. Contoh Kode

* **TDD** (`MyComponent.test.tsx`):

  ```ts
  import { render, screen } from '@testing-library/react';
  test('renders title', () => {
    render(<MyComponent title="Hi" />);
    expect(screen.getByText(/hi/i)).toBeInTheDocument();
  });
  ```

* **BDD** (`Login.behavior.test.tsx`):

  ```ts
  describe('User Login Flow', () => {
    it('should redirect to dashboard after login', async () => {
      render(<LoginPage />);
      userEvent.type(screen.getByLabelText(/email/i), 'a@b.com');
      userEvent.click(screen.getByRole('button', { name: /login/i }));
      expect(await screen.findByText(/welcome/i)).toBeVisible();
    });
  });
  ```

* **E2E** (`e2e/login.spec.ts`):

  ```ts
  import { test, expect } from '@playwright/test';
  test('login and see dashboard', async ({ page }) => {
    await page.goto('/login');
    await page.fill('input[name="email"]', 'a@b.com');
    await page.click('button:has-text("Login")');
    await expect(page).toHaveURL('/dashboard');
  });
  ```

---

*Catatan*: Pisahkan rules jika perlu ke file `.mdc` terpisah untuk maintainability dan scope yang lebih halus.

