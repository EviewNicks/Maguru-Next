  // charts.test.ts
  import { processChartData } from '../service/charts'

  describe('processChartData', () => {
    it('groups users by month correctly', () => {
      const mockUsers = [
        { id: '1', createdAt: '2023-01-15T00:00:00.000Z' },
        { id: '2', createdAt: '2023-01-20T00:00:00.000Z' },
        { id: '3', createdAt: '2023-02-10T00:00:00.000Z' },
      ]

      const result = processChartData(mockUsers)

      expect(result).toEqual([
        { month: 'Jan', users: 2 },
        { month: 'Feb', users: 1 },
      ])
    })

    it('handles empty input', () => {
      expect(processChartData([])).toEqual([])
    })

    it('handles invalid dates', () => {
      const mockUsers = [{ id: '1', createdAt: 'invalid-date' }]

      expect(processChartData(mockUsers)).toEqual([])
    })
  })
  ```

