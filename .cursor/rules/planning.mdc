#### 2.3 Komponen EditUserDialog

- [ ] **Test Case EditUserDialog: Rendering & Form Validation**

  ```typescript
  // EditUserDialog.test.tsx
  import { render, screen, userEvent } from '../../../test-utils'
  import { EditUserDialogNew } from './EditUserDialog'

  // Mock useUserActions
  jest.mock('@/hooks/useUserActions', () => ({
    useUserActions: () => ({
      updateUser: {
        mutateAsync: jest.fn().mockResolvedValue({}),
        isPending: false
      }
    })
  }))

  describe('EditUserDialogNew', () => {
    const mockUser = {/* mock user */}
    const mockOnOpenChange = jest.fn()

    it('renders form fields correctly', () => {
      render(
        <EditUserDialogNew
          user={mockUser}
          open={true}
          onOpenChange={mockOnOpenChange}
        />
      )
      // Check fields present
    })

    it('handles form submission correctly', async () => {
      const { useUserActions } = require('@/hooks/useUserActions')
      const mockUpdateUser = useUserActions().updateUser.mutateAsync

      render(
        <EditUserDialogNew
          user={mockUser}
          open={true}
          onOpenChange={mockOnOpenChange}
        />
      )

      // Change role
      const roleSelect = screen.getByDisplayValue('admin')
      await userEvent.click(roleSelect)
      await userEvent.click(screen.getByText('Mahasiswa'))

      // Submit form
      const saveButton = screen.getByRole('button', { name: /save changes/i })
      await userEvent.click(saveButton)

      expect(mockUpdateUser).toHaveBeenCalledWith({
        id: mockUser.id,
        role: 'mahasiswa',
        status: 'active',
        lastKnownUpdate: mockUser.updatedAt
      })
    })
  })
  ```

