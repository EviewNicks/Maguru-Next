## 3. Implementasi Integration Testing

### Teknologi yang Digunakan
- **Playwright**: Untuk end-to-end testing
- **Jest**: Untuk unit dan integration testing
- **MockServiceWorker**: Untuk mocking API

### Langkah-langkah Implementasi

1. **Setup Integration Test Suite**

```typescript
// __tests__/manage-user/integration/rbac-flow.test.ts
import { test, expect } from '@playwright/test'
import { mockClerkUser, mockAdminUser } from '../__mocks__/users'

// Test end-to-end flow: Admin mengubah role user → Role diupdate di DB → Cache diinvalidasi → User mendapatkan akses sesuai role baru
test.describe('RBAC Integration Flow', () => {
  test('Admin can change user role and user gets updated access', async ({ page, request }) => {
    // 1. Setup: Login sebagai admin
    await page.goto('/login')
    await mockAdminUser(page)
    await page.waitForURL('/admin/dashboard')
    
    // 2. Admin mengubah role user dari mahasiswa menjadi admin
    await page.goto('/admin/users')
    await page.getByTestId('user-row-test-user').click()
    await page.getByTestId('change-role-button').click()
    await page.getByTestId('role-admin').click()
    await page.getByTestId('confirm-button').click()
    
    // 3. Verifikasi pesan sukses
    await expect(page.getByText('Role berhasil diubah')).toBeVisible()
    
    // 4. Verify role updated in database via API
    const dbResponse = await request.get('/api/test/check-user-role?userId=test_user')
    const dbData = await dbResponse.json()
    expect(dbData.role).toBe('admin')
    
    // 5. Logout & login sebagai user yang role-nya baru diubah
    await page.getByTestId('logout-button').click()
    await page.goto('/login')
    await mockClerkUser(page, 'test_user')
    
    // 6. User seharusnya mendapat akses ke halaman admin
    await page.goto('/admin/dashboard')
    // Jika user tidak memiliki akses, akan di-redirect ke /unauthorized
    expect(page.url()).not.toContain('/unauthorized')
    await expect(page.getByTestId('admin-dashboard-title')).toBeVisible()
  })
  
  test('Role cache is invalidated when role is changed', async ({ page, request }) => {
    // 1. Setup
    await mockAdminUser(page)
    
    // 2. Check current cache status
    const initialCacheResponse = await request.get('/api/test/cache-status?userId=test_user')
    const initialCache = await initialCacheResponse.json()
    
    // 3. Change role via API
    await request.post('/api/admin/users/change-role', {
      data: {
        userId: 'test_user',
        role: 'mahasiswa'
      }
    })
    
    // 4. Verify cache was invalidated
    const updatedCacheResponse = await request.get('/api/test/cache-status?userId=test_user')
    const updatedCache = await updatedCacheResponse.json()
    
    expect(initialCache.cached).toBe(true)
    expect(updatedCache.cached).toBe(false) // Cache should be invalidated
  })
  
  test('Backward compatibility with old role format', async ({ request }) => {
    // Test bahwa format role lama masih didukung dengan warning
    const response = await request.get('/api/test/check-backward-compat')
    const data = await response.json()
    
    expect(data.role).toBe('admin') // Should still get correct role
    expect(data._warning).toBeDefined() // Should include deprecation warning
  })
})
```

2. **Implementasi API Endpoint untuk Testing**

```typescript
// app/api/test/check-user-role/route.ts
import { NextRequest, NextResponse } from 'next/server'
import prisma from '@/lib/prisma'
import { auth } from '@clerk/nextjs/server'

export async function GET(req: NextRequest) {
  const { userId } = await auth()
  if (!userId) {
    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
  }
  
  const searchParams = req.nextUrl.searchParams
  const targetUserId = searchParams.get('userId')
  
  if (!targetUserId) {
    return NextResponse.json({ error: 'Missing userId parameter' }, { status: 400 })
  }
  
  const user = await prisma.user.findUnique({
    where: { clerkUserId: targetUserId },
    select: { role: true }
  })
  
  return NextResponse.json({ role: user?.role || 'mahasiswa' })
}

// app/api/test/cache-status/route.ts
import { NextRequest, NextResponse } from 'next/server'
import { roleCache } from '@/lib/cache'
import { auth } from '@clerk/nextjs/server'

export async function GET(req: NextRequest) {
  const { userId } = await auth()
  if (!userId) {
    return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })
  }
  
  const searchParams = req.nextUrl.searchParams
  const targetUserId = searchParams.get('userId')
  
  if (!targetUserId) {
    return NextResponse.json({ error: 'Missing userId parameter' }, { status: 400 })
  }
  
  const cachedRole = roleCache.get(targetUserId)
  
  return NextResponse.json({
    cached: cachedRole !== undefined,
    role: cachedRole,
  })
}
```

