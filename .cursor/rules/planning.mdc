#### 6.1 User Management E2E

- [ ] **Test Case: User Management Workflow**

  ```typescript
  // __tests__/e2e/manage-users/user-management.spec.ts
  import { test, expect } from '@playwright/test'

  test('complete user management workflow', async ({ page }) => {
    // Login (if required)
    await page.goto('/login')
    await page.fill('input[name="email"]', 'admin@example.com')
    await page.fill('input[name="password"]', 'password')
    await page.click('button[type="submit"]')

    // Navigate to user management
    await page.goto('/manage-users')

    // Verify table loads
    await expect(page.locator('h2:has-text("User Management")')).toBeVisible()

    // Test filtering
    await page.selectOption('select#role', 'admin')
    await expect(page.locator('text=Admin')).toBeVisible()

    // Test editing user
    await page.click('button:has-text("Admin")')
    await expect(page.locator('h2:has-text("Edit User")')).toBeVisible()

    // Change role
    await page.selectOption('select[name="role"]', 'mahasiswa')
    await page.click('button:has-text("Save changes")')

    // Verify changes applied
    await expect(page.locator('text=Mahasiswa')).toBeVisible()

    // Test search
    await page.fill('input[placeholder="Cari nama atau email..."]', 'test')
    await expect(page.locator('text=test@example.com')).toBeVisible()
  })
  ```

